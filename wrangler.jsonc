{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echomind",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/models/*", "/auth/*"]
  },
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "app" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "echomind-credits", "database_id": "515c48f9-0877-4480-9b6d-f7622e103a4b" }
  ],
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
