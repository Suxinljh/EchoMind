{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echomind",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/models/*"]
  },
  "r2_buckets": [
    { "binding": "MODELS", "bucket_name": "app" }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
